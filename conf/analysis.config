/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running miRNA analysis
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Working directory must contain a data/ directory with required files.

    Use as follows:
        nextflow run main.nf -profile analysis,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    
    config_profile_name        = 'miRNA analysis profile'
    config_profile_description = 'Profile to analyse miRNA samples'

    mature              = 'data/mature.fa'
    hairpin             = 'data/hairpin.fa'
    mirna_gtf           = 'data/hsa.gff3'
    genome              = 'data/GRCh38.fa.gz'
    genome_index        = 'data/GRCh38_index.tar.gz'
    mirtrace_species    = 'hsa'
    
    save_intermediates  = false
    skip_mirdeep        = true
}

includeConfig 'protocol_illumina.config'
